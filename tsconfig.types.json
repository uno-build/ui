{
    "extends": "./tsconfig.check.json",
    "compilerOptions": {
        "noEmit": false,
        "declaration": true,
        "emitDeclarationOnly": true,
        "noEmitOnError": true,
        "rootDir": "src",
        "outDir": "types"
    },
    "include": ["src/**/*.js", "src/**/*.d.ts"],
    "exclude": [
        "src/core/Renderer.js",
        "src/core/Resources.js",
        "src/ui/UIWorldSpace.js",
        "src/components/solid/driver.js",
        "src/components/octane/driver.js"
    ]
}
