{
    "extends": "./tsconfig.check.json",
    "compilerOptions": {
        "noEmit": false,
        "declaration": true,
        "emitDeclarationOnly": true,
        "noEmitOnError": true,
        "rootDir": "src",
        "outDir": "types"
    },
    "include": ["src/**/*.js", "src/**/*.d.ts", "src/core/**/*.ts", "src/utils/**/*.ts", "src/layouter/**/*.ts", "src/style/**/*.ts", "src/events/**/*.ts"],
    "exclude": [
        "src/ui/UIWorldSpace.js",
        "src/components/solid/driver.js",
        "src/components/octane/driver.js"
    ]
}
