{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": [],
        "skipLibCheck": true
    },
    "include": ["src/events/**/*.ts", "src/core/**/*.ts", "src/style/**/*.ts"]
}
