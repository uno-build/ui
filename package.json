        "test": "npm run test:no-renderer && npm run test:renderer && npm run test:layouts",
        "test:no-renderer": "playwright test --project=no-renderer",
        "test:renderer": "playwright test --project=renderer --workers=1",
        "test:layouts": "playwright test --project=layouts --workers=1",
        "examples": "vite ./examples --config ./examples/vite/typegpu.config.ts",
        "examples:solid": "vite ./examples --config ./examples/vite/solid.config.ts",
        "examples:octane": "vite ./examples --config ./examples/vite/octane.config.ts",
