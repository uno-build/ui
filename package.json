        "benchmark:general": "node ./scripts/benchmarks.mjs --workload general",
        "benchmark:general:headed": "node ./scripts/benchmarks.mjs --workload general --headed",
        "benchmark:box-shadow": "node ./scripts/benchmarks.mjs --workload box-shadow",
        "benchmark:box-shadow:headed": "node ./scripts/benchmarks.mjs --workload box-shadow --headed",
